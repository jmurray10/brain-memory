# Copy to .env (never commit .env). Railway: set these as service variables instead.
DATABASE_URL=postgresql://postgres:brain@localhost:5432/brain
BRAIN_ADMIN_KEY=change-me-long-random-string
BRAIN_DAILY_CAP_USD=5
# Each account's own daily cap inside the one above. Unset: no per-account cap. Set it before a second account exists.
# BRAIN_ACCOUNT_CAP_USD=1
BRAIN_OFFLINE=0
BRAIN_MIGRATE_ON_START=1
VOYAGE_API_KEY=
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
# Optional (defaults shown)
# BRAIN_RATE_PER_MIN=120
# BRAIN_FORGET_GRACE_DAYS=0     # 0: archived text is kept until the user erases it; N: the worker erases it after N days
# DECISION_LOG_DAYS=0           # 0: keep every decision-log row; N: delete rows older than N days
# BRAIN_BACKFILL_MAX=20000
# BRAIN_BACKUP_DIR=           # worker: write nightly backups here
# BRAIN_BACKUP_KEEP=14
# BRAIN_BACKUP_BUCKET=brain-backups   # worker: private Supabase Storage bucket for nightly backups
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=          # worker only
# BRAIN_LOG_LEVEL=INFO
# The upper layers (all off by default; REFERENCE.md lists every setting):
# WRITE_PATH_ENABLED=1          # keep the claims clients send and build the ledger
# BRAIN_LEDGER_ROUTE=1          # use the router and the ledger in the context pack
# Settings measured and on in the reference deployment:
# BRAIN_NEIGHBOURS=1  BRAIN_DATES=1  BRAIN_DATE_NOTES=1  BRAIN_DATE_DIRECTION=1  BRAIN_DATE_COUNTED=1
# BRAIN_CONTEXT_PARALLEL=1  BRAIN_SHORTLIST_SEATS=25,5
# BRAIN_PLACE_PER_SLOT=1  BRAIN_PLACE_CHECK=1  BRAIN_RELATE_ENDS=1  BRAIN_RESOLVE_NAMES=1   # worker
# Tests only
TEST_DATABASE_URL=postgresql://postgres:brain@localhost:5432/brain_test
